{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "angry-marbles-api",
	"main": "worker/index.ts",
	"compatibility_date": "2026-10-12",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://jasonw79118.github.io,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,http://localhost:5177,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178,http://localhost:5179,http://127.0.0.1:5179,http://localhost:5180,http://127.0.0.1:5180"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "angry-marbles",
			"database_id": "ccd28b42-af0b-48fe-8e5b-77a38b3b768d",
			"preview_database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "worker/migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "GAME_ROOMS",
				"class_name": "GameRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GameRoom"
			]
		}
	]
}